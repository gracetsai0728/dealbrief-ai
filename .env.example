# React calls the Flask backend. OpenAI credentials must never use a VITE_ prefix.
VITE_API_URL=http://localhost:3000/api

# Flask / PostgreSQL
DATABASE_URL=postgresql+psycopg://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/dealbriefai
FLASK_DEBUG=true
CORS_ORIGINS=http://localhost:5173
SECRET_KEY=replace-with-a-long-random-secret
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# OpenAI (server-side only)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_BRIEF_MODEL=gpt-5.6-terra
OPENAI_INTELLIGENCE_MODEL=gpt-5.6-terra
# real = verified web news only; hybrid = web first, then labeled demo scenarios; mock = demo only
INTELLIGENCE_NEWS_MODE=hybrid
