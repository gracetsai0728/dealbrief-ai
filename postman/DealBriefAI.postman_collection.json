{
  "info": {
    "_postman_id": "0dd30db0-c785-4a0d-b16e-04c6a4b55101",
    "name": "DealBrief AI - Complete API",
    "description": "Run folders from top to bottom. The workflow signs in as the seeded administrator, verifies subscription-backed APIs and briefs, then cleans up demo data.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000/api"
    },
    {
      "key": "customerId",
      "value": ""
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "subscriptionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Authentication",
      "item": [
        {
          "name": "Admin login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@dealbrief.ai\",\n  \"password\": \"Admin123!\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Administrator signed in', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.user.role).to.eql('admin'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Health and reference data",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Database is reachable', () => pm.expect(pm.response.json().data.status).to.eql('ok'));"
                ]
              }
            }
          ]
        },
        {
          "name": "List products",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/products"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Products returned', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.be.an('array').that.is.not.empty; });",
                  "const product = pm.response.json().data.find(item => item.name === 'CRM Platform') || pm.response.json().data[0];",
                  "pm.collectionVariables.set('productId', product.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List customers",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/customers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Customer array returned', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.be.an('array'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 Manual data management",
      "item": [
        {
          "name": "Create customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Demo Customer\",\n  \"industry\": \"Software\"\n}"
            },
            "url": "{{baseUrl}}/customers"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Customer created', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().data.name).to.eql('Postman Demo Customer'); });",
                  "pm.collectionVariables.set('customerId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Find created customer",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/customers?search=Postman%20Demo"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Created customer is queryable', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.have.length(1); });",
                  "pm.collectionVariables.set('customerId', pm.response.json().data[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create subscription",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"productId\": \"{{productId}}\",\n  \"subscriptionStartDate\": \"2026-01-01\",\n  \"subscriptionEndDate\": \"2026-12-31\",\n  \"subscriptionStatus\": \"active\",\n  \"licensedSeats\": 100\n}"
            },
            "url": "{{baseUrl}}/subscriptions"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Subscription created', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().data.licensedSeats).to.eql(100); });",
                  "pm.collectionVariables.set('subscriptionId', pm.response.json().data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "List customer subscriptions",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/subscriptions?customerId={{customerId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Subscription is stored', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.have.length(1); });",
                  "pm.collectionVariables.set('subscriptionId', pm.response.json().data[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get subscription timeline",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/customers/{{customerId}}/timeline"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Timeline contains licensed-seat points', () => { pm.response.to.have.status(200); const series = pm.response.json().data.series; pm.expect(series).to.have.length(1); pm.expect(series[0].seatPoints).to.be.an('array').that.is.not.empty; });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03 Intelligence",
      "item": [
        {
          "name": "Refresh intelligence (calls OpenAI)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"periodStart\": \"2026-07-01\",\n  \"periodEnd\": \"2026-07-31\"\n}"
            },
            "url": "{{baseUrl}}/customers/{{customerId}}/intelligence/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Intelligence created', () => pm.response.to.have.status(201));",
                  "pm.test('Structured intelligence returned', () => { const data = pm.response.json().data; pm.expect(data.industryDynamics).to.be.an('array').that.is.not.empty; pm.expect(data.recommendedNextSteps.renewal).to.be.an('array').that.is.not.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get latest intelligence",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/customers/{{customerId}}/intelligence/latest"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Latest snapshot persisted', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.generatedAt).to.be.a('string'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "List intelligence history",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/customers/{{customerId}}/intelligence"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('History contains snapshot', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.be.an('array').that.is.not.empty; });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04 Briefs",
      "item": [
        {
          "name": "Generate call brief (calls OpenAI)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"productId\": \"{{productId}}\",\n  \"meetingType\": \"winback\",\n  \"deliverableType\": \"call_brief\",\n  \"notes\": \"Focus on re-engagement value and account recovery.\"\n}"
            },
            "url": "{{baseUrl}}/generate-brief"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Brief generated without engagement log', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().data).not.to.have.property('engagementId'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Get customer dashboard",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/customers/{{customerId}}/dashboard"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Dashboard is subscription-backed', () => { pm.response.to.have.status(200); const data = pm.response.json().data; pm.expect(data.customer.id).to.eql(pm.collectionVariables.get('customerId')); pm.expect(data.latestSubscriptions).to.be.an('array').that.is.not.empty; pm.expect(data).not.to.have.property('engagementTimeline'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 Delete and database verification",
      "item": [
        {
          "name": "Delete subscription (hard delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/subscriptions/{{subscriptionId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Subscription hard-deleted', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.deleteMode).to.eql('hard'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify subscription deleted",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/subscriptions?customerId={{customerId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Subscription absent', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.some(item => item.id === pm.collectionVariables.get('subscriptionId'))).to.be.false; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete customer (soft delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/customers/{{customerId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Customer soft-deleted', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data.deleteMode).to.eql('soft'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify customer hidden",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/customers?search=Postman%20Demo"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Soft-deleted customer absent from active list', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().data).to.have.length(0); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
